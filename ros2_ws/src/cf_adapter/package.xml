<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cf_adapter</name>
  <version>0.1.0</version>
  <description>Adaptador entre la API propia (/hk/...) y Crazyswarm2. Único paquete que conoce nombres de Crazyswarm2.</description>
  <maintainer email="alipazaga.daniel@gmail.com">Daniel Alipázaga Lazo</maintainer>
  <license>TODO</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>hackathon_interfaces</exec_depend>
  <exec_depend>crazyflie_interfaces</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
