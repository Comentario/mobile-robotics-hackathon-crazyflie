Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Global Options:
    Background Color: 245; 245; 245
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Map
      Name: Synthetic polygon and obstacle
      Enabled: true
      Alpha: 0.8
      Topic:
        Value: /hk/shared_map/raw
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/Map
      Name: Clearance (optional overlay)
      Enabled: false
      Alpha: 0.3
      Topic:
        Value: /hk/shared_map/inflated
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/Path
      Name: Requested path - RED - blocked
      Enabled: true
      Color: 210; 40; 40
      Alpha: 1
      Line Style: Lines
      Line Width: 0.02
      Topic:
        Value: /hk/path/initial
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/Path
      Name: Modified original mission - empty if blocked
      Enabled: true
      Color: 30; 80; 220
      Alpha: 1
      Line Style: Lines
      Line Width: 0.02
      Topic:
        Value: /hk/path/modified
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/Path
      Name: Alternative proposal - GREEN - changes waypoints
      Enabled: true
      Color: 20; 150; 70
      Alpha: 1
      Line Style: Lines
      Line Width: 0.02
      Topic:
        Value: /hk/path/proposed
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Top view
      Angle: 0
      Scale: 150
      X: 0.2
      Y: 0.1
Window Geometry:
  Width: 1100
  Height: 700
