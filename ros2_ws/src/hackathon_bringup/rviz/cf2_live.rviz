Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Enabled: true
  Name: root
  Value: true
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Global Options:
    Background Color: 226; 237; 246
    Fixed Frame: cf2_display
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Metric grid - 0.5 m
      Enabled: false
      Value: false
      Cell Size: 0.5
      Plane Cell Count: 20
      Color: 138; 153; 174
      Alpha: 0.18
      Line Style:
        Value: Lines
        Line Width: 0.01
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/Map
      Name: Occupancy texture - optional
      Enabled: false
      Value: false
      Alpha: 0.55
      Color Scheme: map
      Draw Behind: true
      Topic:
        Value: /cf2/presentation/map
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Transient Local
    - Class: rviz_default_plugins/Path
      Name: Flight trajectory
      Enabled: true
      Value: true
      Color: 0; 142; 190
      Alpha: 1
      Line Style: Billboards
      Line Width: 0.018
      Pose Style: None
      Buffer Length: 1
      Topic:
        Value: /cf2/presentation/trail
        Depth: 10
        Reliability Policy: Reliable
        Durability Policy: Volatile
    - Class: rviz_default_plugins/Path
      Name: Local planned route
      Enabled: true
      Value: true
      Color: 155; 68; 210
      Alpha: 0.85
      Line Style: Billboards
      Line Width: 0.02
      Pose Style: None
      Buffer Length: 1
      Topic:
        Value: /cf2/presentation/plan
        Depth: 10
        Reliability Policy: Reliable
        Durability Policy: Volatile
    - Class: rviz_default_plugins/MarkerArray
      Name: Map - robot - ToF
      Enabled: true
      Value: true
      Topic:
        Value: /cf2/presentation/markers
        Depth: 10
        Reliability Policy: Reliable
        Durability Policy: Volatile
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Value: Orbit (rviz)
      Distance: 7.3
      Pitch: 1.5707
      Yaw: -1.570796
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Top-down live map
      Target Frame: <Fixed Frame>
      X: 0
      Y: 0
      Near Clip Distance: 0.01
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
Window Geometry:
  Width: 1440
  Height: 900
  Displays:
    collapsed: false
  Views:
    collapsed: true
