Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 18; 25; 36
    Fixed Frame: cf2_display
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Metric grid - 0.5 m
      Enabled: true
      Cell Size: 0.5
      Plane Cell Count: 20
      Color: 58; 73; 91
      Alpha: 0.4
      Line Style:
        Value: Lines
        Line Width: 0.01
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/Map
      Name: Observed space
      Enabled: true
      Alpha: 0.55
      Color Scheme: map
      Draw Behind: true
      Topic:
        Value: /cf2/presentation/map
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Transient Local
    - Class: rviz_default_plugins/Path
      Name: Flight trajectory
      Enabled: true
      Color: 44; 203; 230
      Alpha: 1
      Line Style: Billboards
      Line Width: 0.025
      Pose Style: None
      Buffer Length: 1
      Topic:
        Value: /cf2/presentation/trail
        Depth: 10
        Reliability Policy: Reliable
        Durability Policy: Volatile
    - Class: rviz_default_plugins/Path
      Name: Planned route
      Enabled: true
      Color: 183; 114; 250
      Alpha: 0.85
      Line Style: Billboards
      Line Width: 0.02
      Pose Style: None
      Buffer Length: 1
      Topic:
        Value: /cf2/presentation/plan
        Depth: 10
        Reliability Policy: Reliable
        Durability Policy: Volatile
    - Class: rviz_default_plugins/MarkerArray
      Name: Robot - origin - ToF - observations
      Enabled: true
      Topic:
        Value: /cf2/presentation/markers
        Depth: 10
        Reliability Policy: Reliable
        Durability Policy: Volatile
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Top-down live map
      Target Frame: <Fixed Frame>
      Angle: 0
      Scale: 160
      X: 0
      Y: 0
      Near Clip Distance: 0.01
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
Window Geometry:
  Width: 1440
  Height: 900
  Displays:
    collapsed: false
  Views:
    collapsed: true
